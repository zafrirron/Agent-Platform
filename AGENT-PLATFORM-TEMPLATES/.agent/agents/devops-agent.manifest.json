{
  "id": "devops-agent",
  "display_name": "DevOps",
  "version": "1.0",
  "capabilities": ["CI/CD", "Docker", "infrastructure", "deployment", "build-pipeline", "monitoring", "secrets-management", "release"],
  "cannot_do": ["application-logic", "UI", "database-schema", "business-rules"],
  "governance": {
    "critic_dimensions": ["SECURITY", "CORRECTNESS", "COMPLETENESS", "DEPENDENCY"],
    "requires_architect_for": ["new-cloud-provider", "infrastructure-overhaul", "zero-downtime-migration"],
    "always_runs_security_gate": true
  },
  "routing_keywords": ["CI/CD", "Docker", "deploy", "pipeline", "Kubernetes", "infra", "build", "release", "ship", "publish"],
  "trust_ceiling": "trusted",
  "reputation_capabilities": ["CI/CD", "security", "deployment"]
}
