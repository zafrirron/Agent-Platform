# Suggested .gitignore for a framework-only repository (rename to .gitignore when creating the new repo)

node_modules/
.DS_Store
Thumbs.db

# Platform self-install artefacts at repo root — templates under AGENT-PLATFORM-TEMPLATES/ stay tracked
/.agent/
/.claude/
/.cursor/
/.agents/
/.codex/
/AGENTS.md
/CLAUDE.md
/SYNC-POINTS.md

# Local E2E rehearsal scratch (npm run test:manual --dir=...)
/tests/e2e-scratch/
/tests/e2e-state.json