{
  "schema_version": 1,
  "bootstrap_version": "2.45.0",
  "description": "Template manifest for Agent Platform Bootstrap. Consumer-project neutral.",
  "templates_root": "AGENT-PLATFORM-TEMPLATES",
  "apply_script": ".agent/bootstrap/apply.js",
  "platform_repo": "zafrirron/Agent-Platform",
  "platform_npx": "github:zafrirron/Agent-Platform",
  "placeholders": [
    "PROJECT_NAME",
    "PROJECT_DESCRIPTION",
    "DATE",
    "HIGH_CONFLICT_PATHS",
    "TEST_RUNNER",
    "COVERAGE_CMD",
    "COVERAGE_THRESHOLD",
    "BOOTSTRAP_VERSION",
    "PLATFORM_REPO",
    "PLATFORM_NPX"
  ],
  "frameworks": [
    "cursor",
    "claude",
    "antigravity",
    "codex",
    "opencode"
  ],
  "profiles": {
    "lite": "Skills pack — lifecycle commands, cherry-pick skills, no handoff/enterprise layer",
    "core": "All playbooks except enterprise; full session model",
    "full": "Complete platform (default)"
  },
  "skills_catalog": [
    { "id": "using-platform", "description": "Pick the right skill or playbook" },
    { "id": "interview-me", "description": "One-question-at-a-time requirements interview" },
    { "id": "idea-refine", "description": "Diverge/converge on vague ideas" },
    { "id": "planning-and-task-breakdown", "description": "Spec to ordered task list" },
    { "id": "incremental-implementation", "description": "Vertical slices; supports build auto" },
    { "id": "test-driven-development", "description": "Red-Green-Refactor, test pyramid" },
    { "id": "code-simplification", "description": "Simplify without behavior change" },
    { "id": "browser-testing-devtools", "description": "Browser MCP testing (optional)" },
    { "id": "web-performance-audit", "description": "CWV / API perf audit — Quick/Deep, /webperf" },
    { "id": "context-engineering", "description": "Context hierarchy, selective loading, confusion gates — /context" },
    { "id": "verification-before-completion", "description": "Evidence before done — /verify" },
    { "id": "ux-research", "description": "User research / usability / journey mapping (optional domain skill, cherry-pick)" },
    { "id": "caveman", "description": "Token compression mode" }
  ],
  "packs_catalog": [
    { "id": "language-typescript", "kind": "language", "display_name": "TypeScript", "description": "TS type safety, boundary validation, strict-mode pitfalls", "detect": { "files": ["tsconfig.json"], "deps": ["typescript"], "extensions": [".ts", ".tsx"] } },
    { "id": "language-java", "kind": "language", "display_name": "Java", "description": "Java concurrency, RAII/resources, equals/immutability pitfalls", "detect": { "files": ["pom.xml", "build.gradle", "build.gradle.kts"], "deps": [], "extensions": [".java"] } },
    { "id": "language-cpp", "kind": "language", "display_name": "C++", "description": "C++ ownership/RAII, memory safety, UB and rule-of-5 pitfalls", "detect": { "files": ["CMakeLists.txt", "conanfile.txt", "vcpkg.json"], "deps": [], "extensions": [".cpp", ".cc", ".cxx", ".hpp"] } },
    { "id": "stack-react", "kind": "stack", "display_name": "React", "description": "React idioms, hook/render pitfalls, perf traps", "detect": { "deps": ["react", "react-dom"], "globs": ["**/*.tsx", "**/*.jsx"] } },
    { "id": "stack-django", "kind": "stack", "display_name": "Django", "description": "Django ORM/N+1, migrations, settings/security pitfalls", "detect": { "files": ["manage.py"], "deps": ["django", "Django"], "globs": ["**/settings.py"] } },
    { "id": "domain-fintech", "kind": "domain", "display_name": "Fintech / Payments", "description": "Double-entry ledger, PCI, idempotent money ops + reference architecture", "detect": { "deps": ["stripe", "plaid", "braintree", "adyen"] } }
  ],
